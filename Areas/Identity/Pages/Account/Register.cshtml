@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-surface py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

                <div class="auth-card">
                    <div class="p-4 p-md-5">
                        <div class="mb-4">
                            <h1 class="auth-title">Create your account</h1>
                            <p class="text-white-50 mb-0">Create your account to start browsing and listing items.</p>
                        </div>

                        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="vstack gap-3">
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                            <div>
                                <div class="form-floating">
                                    <input asp-for="Input.Email"
                                           class="form-control custom-placeholder"
                                           placeholder="name@example.com"
                                           autocomplete="email" />
                                    <label asp-for="Input.Email" class="form-label">Email</label>
                                </div>
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>

                            <div>
                                <div class="form-floating">
                                    <input asp-for="Input.Password"
                                           class="form-control custom-placeholder"
                                           placeholder="password"
                                           autocomplete="new-password" />
                                    <label asp-for="Input.Password" class="form-label">Password</label>
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>

                            <div>
                                <div class="form-floating">
                                    <input asp-for="Input.ConfirmPassword"
                                           class="form-control custom-placeholder"
                                           placeholder="password"
                                           autocomplete="new-password" />
                                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                                </div>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                            </div>

                            <button id="registerSubmit" type="submit" class="btn btn-emerald btn-lg w-100">
                                Create account
                            </button>

                            <div class="text-center text-white-50 small">
                                Already have an account?
                                <a class="auth-link"
                                   asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">
                                    Log in
                                </a>
                            </div>
                        </form>

                        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                        {
                            <hr class="my-4" />
                            <section>
                                <h2 class="h6 fw-semibold mb-3">Or register with</h2>
                                    <form id="external-account"
                                          asp-page="./ExternalLogin"
                                          asp-route-returnUrl="@Model.ReturnUrl"
                                          method="post">
                                        <div class="d-grid gap-2">
                                            @foreach (var provider in Model.ExternalLogins!)
                                            {
                                                <button type="submit"
                                                        class="btn btn-outline-light"
                                                        name="provider"
                                                        value="@provider.Name"
                                                        title="Register using your @provider.DisplayName account">
                                                    Continue with @provider.DisplayName
                                                </button>
                                            }
                                        </div>
                                    </form>
                                </section>
                        }
                    </div>
                </div>

                <p class="text-center text-white-50 small mt-4 mb-0">
                    <a class="auth-back"
                       asp-area="" asp-controller="Home" asp-action="Landing"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to home</a>
                </p>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}