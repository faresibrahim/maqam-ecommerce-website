@{
    ViewData["Title"] = "Order not placed";
}

<div class="page-surface">
    <div class="container">
        <div class="empty-state">
            <span class="empty-icon is-danger" aria-hidden="true"><i class="bi bi-exclamation-lg"></i></span>
            <h1>We couldn't place your order</h1>
            <p>Something went wrong on our side. Your cart is still saved, so you can try again in a moment.</p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-controller="Cart" asp-action="GetUserCart" class="btn btn-emerald px-4">Back to cart</a>
                <a href="mailto:fares.a.ibrahim@gmail.com" class="btn btn-outline-light px-4">Contact us</a>
            </div>
        </div>
    </div>
</div>
