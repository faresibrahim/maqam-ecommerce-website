@model CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="page-surface pb-5">
    <div class="container" style="max-width: 820px;">

        <header class="page-head">
            <div>
                <h1 class="page-title">Checkout</h1>
                <p class="page-lede">Tell us where to reach you and how you'd like to pay.</p>
            </div>
            <a asp-controller="Cart" asp-action="GetUserCart" class="text-link">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to cart
            </a>
        </header>

        <div class="cart-card p-4 p-md-5">
            <form asp-action="Checkout" method="post" novalidate>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-4" role="alert"></div>

                <section class="checkout-section">
                    <h2>Contact details</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" asp-for="Name" placeholder="Full name" autocomplete="name" />
                                <label asp-for="Name">Full name</label>
                            </div>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="email" class="form-control" asp-for="Email" placeholder="name@example.com" autocomplete="email" />
                                <label asp-for="Email">Email</label>
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="tel" class="form-control" asp-for="MobileNumber" placeholder="059 000 0000" autocomplete="tel" />
                                <label asp-for="MobileNumber">Mobile number</label>
                            </div>
                            <span asp-validation-for="MobileNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="text" class="form-control" asp-for="Address" placeholder="City, street" autocomplete="street-address" />
                                <label asp-for="Address">Address</label>
                            </div>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <section class="checkout-section">
                    <h2>Payment</h2>
                    <div class="form-floating">
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="">Choose a payment method</option>
                            @foreach (var method in Enum.GetValues<MusicShoppingCartMvcUI.Constants.PaymentMethods>())
                            {
                                <option value="@method.ToString()">
                                    @(method == MusicShoppingCartMvcUI.Constants.PaymentMethods.COD ? "Cash on delivery" : method.ToString())
                                </option>
                            }
                        </select>
                        <label asp-for="PaymentMethod">Payment method</label>
                    </div>
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                </section>

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-5">
                    <button type="submit" class="btn btn-emerald btn-lg px-5">
                        Place order
                    </button>
                </div>

            </form>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
