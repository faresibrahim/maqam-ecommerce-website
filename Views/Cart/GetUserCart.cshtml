@model ShoppingCart
@{
    ViewData["Title"] = "Your cart";
}

<div class="page-surface pb-5">
    <div class="container">

        @if (Model != null && Model.CartDetails != null && Model.CartDetails.Count > 0)
        {
            var itemCount = Model.CartDetails.Sum(item => item.Quantity);
            var total = Model.CartDetails.Sum(item => item.Product.Price * item.Quantity);

            <header class="page-head">
                <div>
                    <h1 class="page-title">Your cart</h1>
                    <p class="page-lede">@(itemCount == 1 ? "1 item" : $"{itemCount} items") ready for checkout.</p>
                </div>
                <a asp-controller="Home" asp-action="Index" class="text-link">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> Continue shopping
                </a>
            </header>

            <div class="cart-layout">
                <ul class="cart-card cart-lines">
                    @foreach (var item in Model.CartDetails)
                    {
                        var atStockLimit = item.Quantity >= item.Product.Stocks.Quantity;

                        <li class="cart-line">
                            <img src="/images/@(string.IsNullOrEmpty(item.Product.Image) ? "NoImage.png" : item.Product.Image)"
                                 alt="" class="product-thumb" width="72" height="72" />

                            <div>
                                <h2 class="cart-line-name">@item.Product.ProductName</h2>
                                <div class="cart-line-meta">
                                    @item.Product.Category.CategoryName · @item.Product.Price.ToString("#,0.##") ₪ each
                                </div>
                                @if (atStockLimit)
                                {
                                    <div class="stock-note mt-1">That's all we have in stock</div>
                                }
                            </div>

                            <div class="cart-line-end">
                                <div class="cart-line-total">@((item.Product.Price * item.Quantity).ToString("#,0.##")) ₪</div>
                                <div class="qty-stepper" role="group" aria-label="Quantity of @item.Product.ProductName">
                                    <a href="/Cart/RemoveItem?productId=@item.ProductId"
                                       aria-label="@(item.Quantity == 1 ? "Remove" : "Decrease quantity of") @item.Product.ProductName">
                                        <i class="bi @(item.Quantity == 1 ? "bi-trash3" : "bi-dash")" aria-hidden="true"></i>
                                    </a>
                                    <output aria-live="polite">@item.Quantity</output>
                                    @if (atStockLimit)
                                    {
                                        <span aria-disabled="true" title="No more in stock"><i class="bi bi-plus" aria-hidden="true"></i></span>
                                    }
                                    else
                                    {
                                        <a href="/Cart/AddItem?productId=@item.ProductId&redirect=1"
                                           aria-label="Increase quantity of @item.Product.ProductName">
                                            <i class="bi bi-plus" aria-hidden="true"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>

                <aside class="cart-card summary-card" aria-labelledby="summary-title">
                    <h2 id="summary-title">Order summary</h2>
                    <div class="summary-row">
                        <span>Items</span>
                        <span>@itemCount</span>
                    </div>
                    <div class="summary-total">
                        <span>Total</span>
                        <span class="amount">@total.ToString("#,0.##") <span class="fs-6 text-white-50">₪</span></span>
                    </div>
                    <a class="btn btn-emerald btn-lg w-100" asp-controller="Cart" asp-action="Checkout">
                        Checkout
                    </a>
                </aside>
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="empty-icon" aria-hidden="true"><i class="bi bi-bag"></i></span>
                <h1>Your cart is empty</h1>
                <p>Looks like you haven’t added anything yet. Browse the instruments our team has reviewed and listed.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-emerald px-4">Start shopping</a>
            </div>
        }

    </div>
</div>
