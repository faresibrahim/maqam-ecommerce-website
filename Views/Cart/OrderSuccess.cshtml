@{
    ViewData["Title"] = "Order placed";
}

<div class="page-surface">
    <div class="container">
        <div class="empty-state">
            <span class="empty-icon" aria-hidden="true"><i class="bi bi-check2"></i></span>
            <h1>Thank you, your order is in</h1>
            <p>Your order has been received and is now being processed. You can follow its status from your orders page.</p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-controller="UserOrder" asp-action="UserOrders" class="btn btn-emerald px-4">View my orders</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light px-4">Continue shopping</a>
            </div>
        </div>
    </div>
</div>
