@using Microsoft.AspNetCore.Identity
@model ProductDisplayModel
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Products";
    var isSignedIn = SignInManager.IsSignedIn(User);
    var productCount = Model.Products?.Count() ?? 0;
    var activeCategory = Model.Categories?.FirstOrDefault(c => c.CategoryId == Model.CategoryId);
    var isFiltered = activeCategory != null || !string.IsNullOrWhiteSpace(Model.STerm);
    var loginUrl = Url.Page("/Account/Login", new { area = "Identity", returnUrl = Context.Request.Path + Context.Request.QueryString });
}

<div class="page-surface pb-5">
    <div class="container">

        <header class="page-head">
            <div>
                <h1 class="page-title">@(activeCategory?.CategoryName ?? "All instruments")</h1>
                <p class="page-lede">Every listing is reviewed by our team before it goes live.</p>
            </div>
        </header>

        <form asp-action="Index" method="get" class="filter-bar" role="search">
            <div>
                <label class="visually-hidden" for="CategoryId">Category</label>
                <select class="form-select" id="CategoryId" name="categoryId">
                    <option value="0">All categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option selected="@(category.CategoryId == Model.CategoryId)" value="@category.CategoryId">
                            @category.CategoryName
                        </option>
                    }
                </select>
            </div>

            <div class="search-field">
                <label class="visually-hidden" for="sterm">Search instruments</label>
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search"
                       class="form-control"
                       value="@Model.STerm"
                       id="sterm"
                       name="sterm"
                       placeholder="Search by name, e.g. violin" />
            </div>

            <div class="filter-actions">
                <button type="submit" class="btn btn-emerald px-4">Search</button>
                @if (isFiltered)
                {
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light px-3">Clear</a>
                }
            </div>
        </form>

        <p class="result-meta" aria-live="polite">
            @(productCount == 1 ? "1 instrument" : $"{productCount} instruments")
            @if (!string.IsNullOrWhiteSpace(Model.STerm))
            {
                <text> matching “@Model.STerm”</text>
            }
        </p>

        @if (productCount == 0)
        {
            <div class="empty-state" style="min-height: 40vh;">
                <span class="empty-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
                <h2>Nothing matches that search</h2>
                <p>Try a shorter search term or pick a different category. New instruments are added as sellers send them in.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light px-4">Show all instruments</a>
            </div>
        }
        else
        {
            <div class="row g-3 g-lg-4">
                @foreach (var product in Model.Products)
                {
                    var inStock = product.Quantity > 0;

                    <div class="col-6 col-md-4 col-xl-3">
                        <article class="product-card">
                            <div class="product-media @(inStock ? "" : "is-sold-out")">
                                <img src="/images/@(string.IsNullOrEmpty(product.Image) ? "NoImage.png" : product.Image)"
                                     alt="@product.ProductName"
                                     loading="lazy"
                                     width="400" height="400">
                                @if (!inStock)
                                {
                                    <span class="stock-flag">Sold out</span>
                                }
                                else if (product.Quantity <= 2)
                                {
                                    <span class="stock-flag is-low">Only @product.Quantity left</span>
                                }
                                else
                                {
                                    <span class="stock-flag">@product.Quantity in stock</span>
                                }
                            </div>

                            <div class="product-body">
                                <div class="product-category">@product.CategoryName</div>
                                <h2 class="product-title" title="@product.ProductName">@product.ProductName</h2>

                                <div class="product-price">
                                    @product.Price.ToString("#,0.##")<span class="currency">₪</span>
                                </div>

                                @if (!inStock)
                                {
                                    <button type="button" class="btn btn-quiet w-100" disabled>Sold out</button>
                                }
                                else if (isSignedIn)
                                {
                                    <button type="button"
                                            class="btn btn-emerald w-100 js-add-to-cart"
                                            data-product-id="@product.ProductId">
                                        <span class="btn-label-default">Add to cart</span>
                                        <span class="btn-label-done"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Added</span>
                                    </button>
                                }
                                else
                                {
                                    <a class="btn btn-emerald w-100" href="@loginUrl">Add to cart</a>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("click", async function (event) {
            const button = event.target.closest(".js-add-to-cart");
            if (!button || button.disabled) return;

            button.disabled = true;
            try {
                const response = await fetch(`/Cart/AddItem?productId=${button.dataset.productId}`);
                const isJson = (response.headers.get("content-type") || "").includes("application/json");

                if (response.redirected || !isJson) {
                    window.location.href = response.url;
                    return;
                }
                if (!response.ok) throw new Error(`Request failed: ${response.status}`);

                window.setCartCount(await response.json(), true);
                button.classList.add("is-added");
                setTimeout(() => button.classList.remove("is-added"), 1800);
            } catch (err) {
                console.error(err);
                button.querySelector(".btn-label-default").textContent = "Try again";
            } finally {
                button.disabled = false;
            }
        });
    </script>
}
