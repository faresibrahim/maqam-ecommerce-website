@{
    ViewData["Title"] = "About";
}

<div class="page-surface">
    <div class="container">

        <header class="about-hero">
            <h1 class="page-title">About Maqam</h1>
            <p class="page-lede">
                A Palestinian-built platform dedicated entirely to musical instruments —
                designed with musicians in mind, from the first listing to the final sale.
            </p>
        </header>

        <section class="about-story" aria-labelledby="story-title">
            <div>
                <h2 id="story-title">Our story</h2>
                <div class="name-mark" lang="ar" aria-hidden="true">مقام</div>
            </div>
            <div class="prose">
                <p>
                    Maqam started with a simple observation: musicians in the West Bank had
                    no dedicated space to buy and sell instruments. Generic classifieds were
                    cluttered and untrustworthy. Social media posts got buried.
                </p>
                <p>
                    We built Maqam to fill that gap — a focused, music-only digital shop
                    where every listing is reviewed by our team before it goes live,
                    so buyers know exactly what they're getting.
                </p>
                <p>
                    The name <strong>Maqam (<span lang="ar">مقام</span>)</strong> refers to the
                    melodic frameworks at the heart of Arabic music — a fitting name for a
                    platform rooted in the musical culture of Palestine.
                </p>
            </div>
        </section>

        <section class="about-story" aria-labelledby="works-title">
            <h2 id="works-title">How Maqam works</h2>
            <ol class="about-steps">
                <li>
                    <h3>Sellers contact us</h3>
                    <p>Individuals or music shops send us photos and details of the instrument they want to list.</p>
                </li>
                <li>
                    <h3>We review and publish</h3>
                    <p>Our team verifies the listing, writes a clean description, sets the price, and publishes it to the store.</p>
                </li>
                <li>
                    <h3>Buyer purchases, we facilitate</h3>
                    <p>When a buyer is ready, we coordinate the handoff between both parties and confirm the sale.</p>
                </li>
            </ol>
        </section>

        <section class="about-story" aria-labelledby="values-title">
            <h2 id="values-title" class="visually-hidden">What we stand for</h2>
            <div class="values" style="grid-column: 1 / -1;">
                <div class="value">
                    <h3><i class="bi bi-patch-check" aria-hidden="true"></i>Reviewed listings</h3>
                    <p>
                        Every instrument is checked by our team before it appears on the site.
                        No scams, no misleading photos.
                    </p>
                </div>
                <div class="value">
                    <h3><i class="bi bi-music-note-beamed" aria-hidden="true"></i>Music-only focus</h3>
                    <p>
                        Unlike general online shops, Maqam is built around instruments.
                        Every feature, every category, every detail is for musicians.
                    </p>
                </div>
                <div class="value">
                    <h3><i class="bi bi-geo-alt" aria-hidden="true"></i>Local &amp; trusted</h3>
                    <p>
                        We operate within the West Bank. Buyers and sellers are local,
                        meetups are real, and the team is reachable.
                    </p>
                </div>
            </div>
        </section>

        <section class="about-cta" aria-labelledby="cta-title">
            <div>
                <h2 id="cta-title">Ready to browse or sell?</h2>
                <p>
                    Whether you're looking for your next instrument or want to pass one on —
                    Maqam is the right place.
                </p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Home" asp-action="Index" class="btn btn-emerald btn-lg px-4">Browse products</a>
                <a href="mailto:fares.a.ibrahim@gmail.com" class="btn btn-outline-light btn-lg px-4">Sell an instrument</a>
            </div>
        </section>

    </div>
</div>
