@model IEnumerable<Category>

@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="container">
        <div class="hero-content">
            <h1 class="hero-title">
                Give your instrument a new <em>voice.</em>
            </h1>

            <p class="hero-lede">
                Discover quality instruments at the best prices. Buy and sell used
                musical instruments across the West Bank.
            </p>

            <div class="hero-actions d-flex gap-3 flex-wrap">
                <a asp-controller="Home" asp-action="Index" class="btn btn-emerald btn-lg px-4">
                    Browse products
                </a>
                <a asp-controller="Home" asp-action="About" class="btn btn-outline-light btn-lg px-4">
                    How Maqam works
                </a>
            </div>
        </div>
    </div>
</section>

@if (Model != null && Model.Any())
{
    <section class="categories-section" aria-labelledby="categories-title">
        <div class="container">
            <div class="section-head">
                <h2 id="categories-title" class="section-title">What are you <br>looking for?</h2>
                <a class="text-link" asp-controller="Home" asp-action="Index">
                    See all instruments <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
            </div>

            <div class="categories-grid">
                @foreach (var item in Model)
                {
                    <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@item.CategoryId" class="cat-card">
                        <span class="cat-icon" aria-hidden="true">@item.Icon</span>
                        <span class="cat-name">
                            @item.CategoryName
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </span>
                    </a>
                }
            </div>
        </div>
    </section>
}

<section class="how-section" aria-labelledby="how-title">
    <div class="container">
        <h2 id="how-title" class="section-title">Simple as a <em>three&#8209;note melody</em></h2>

        <ol class="steps">
            <li class="step">
                <span class="step-num" aria-hidden="true">1</span>
                <h3 class="step-title">Send us your instrument</h3>
                <p class="step-desc">
                    Local music shops or individual sellers contact us with photos and details of the instrument
                    they want to sell. We review it and prepare the listing.
                </p>
            </li>

            <li class="step">
                <span class="step-num" aria-hidden="true">2</span>
                <h3 class="step-title">We publish the product</h3>
                <p class="step-desc">
                    Our team uploads the instrument to Maqam with photos,
                    description, and price so it can be discovered by musicians
                    across the West Bank.
                </p>
            </li>

            <li class="step">
                <span class="step-num" aria-hidden="true">3</span>
                <h3 class="step-title">A musician buys it</h3>
                <p class="step-desc">
                    Interested buyers contact us to purchase the instrument.
                    We connect both sides and help complete the sale.
                </p>
            </li>
        </ol>
    </div>
</section>

<section class="mission-section" aria-label="Our mission">
    <div class="mission-bg-num" lang="ar" aria-hidden="true">وتر</div>

    <div class="container mission-inner">
        <p class="mission-quote">
            Music doesn't have to be <em>expensive</em> to be beautiful.
        </p>

        <div class="mission-body">
            <p>
                Maqam was built for the musicians of Palestine — the self-taught guitarist in Nablus,
                the oud player in Hebron passing down tradition, the student in Ramallah who can't
                afford a new instrument.
            </p>

            <p>
                Thousands of instruments sit in closets and storage rooms, forgotten.
                We believe every one of them deserves to be played again.
            </p>

            <p>
                Our platform connects sellers and buyers across the West Bank —
                no middlemen, no complexity. <strong>Just music finding new hands.</strong>
            </p>
        </div>
    </div>
</section>
