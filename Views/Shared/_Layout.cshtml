@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavState(string controller, string action) =>
        currentController == controller && currentAction == action ? "active" : "";
    string? AriaCurrent(string controller, string action) =>
        currentController == controller && currentAction == action ? "page" : null;
}
<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#121110">
    <title>@(ViewData["Title"] is string title && title != "Home" ? $"{title} · Maqam" : "Maqam · Musical instruments in Palestine")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true">
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header sticky-top">
        <nav class="navbar navbar-expand-lg" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand me-lg-5" asp-controller="Home" asp-action="Landing" aria-label="Maqam home">
                    <span class="maqam-elegant">
                        <span class="wordmark">Maqam</span>
                        <span class="wordmark-ar" lang="ar">مقام</span>
                    </span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto gap-lg-1 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link px-lg-3 @NavState("Home", "Landing")" aria-current="@AriaCurrent("Home", "Landing")"
                               asp-controller="Home" asp-action="Landing">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-lg-3 @NavState("Home", "Index")" aria-current="@AriaCurrent("Home", "Index")"
                               asp-controller="Home" asp-action="Index">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-lg-3 @NavState("Home", "About")" aria-current="@AriaCurrent("Home", "About")"
                               asp-controller="Home" asp-action="About">About</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 ms-lg-auto my-3 my-lg-0">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" class="flex-grow-1">
        <partial name="_Notifications" />
        @RenderBody()
    </main>

    <footer class="site-footer mt-auto">
        <div class="container">
            <div class="row gy-5">
                <div class="col-lg-5">
                    <div class="footer-brand">Maqam</div>
                    <p class="footer-blurb mb-0">
                        A focused digital shop for musicians to buy and sell instruments
                        with simplicity, clarity, and trust.
                    </p>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <h2>Shop</h2>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Landing">Home</a></li>
                        <li><a asp-controller="Home" asp-action="Index">Products</a></li>
                        <li><a asp-controller="Home" asp-action="About">About</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <h2>Account</h2>
                    <ul>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li><a asp-controller="UserOrder" asp-action="UserOrders">My orders</a></li>
                            <li><a asp-controller="Cart" asp-action="GetUserCart">Cart</a></li>
                            <li><a asp-area="Identity" asp-page="/Account/Manage/Index">Settings</a></li>
                        }
                        else
                        {
                            <li><a asp-area="Identity" asp-page="/Account/Login">Log in</a></li>
                            <li><a asp-area="Identity" asp-page="/Account/Register">Create account</a></li>
                        }
                    </ul>
                </div>

                <div class="col-md-4 col-lg-3">
                    <h2>Contact</h2>
                    <ul>
                        <li><a href="mailto:fares.a.ibrahim@gmail.com">fares.a.ibrahim@gmail.com</a></li>
                        <li><a href="tel:+972592333972">(+972) 59-233-3972</a></li>
                        <li>Bethlehem, Palestine</li>
                    </ul>
                </div>
            </div>

            <div class="footer-base">
                &copy; @DateTime.Now.Year Maqam Market-Place. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script>
        window.setCartCount = function (count, animate) {
            const badge = document.getElementById("cartCount");
            if (!badge) return;
            const n = Number(count) || 0;
            badge.textContent = n;
            badge.classList.toggle("is-empty", n === 0);
            const link = badge.closest("a");
            if (link) link.setAttribute("aria-label", n === 1 ? "Cart, 1 item" : `Cart, ${n} items`);
            if (animate) {
                badge.classList.remove("bump");
                void badge.offsetWidth;
                badge.classList.add("bump");
            }
        };

        (async function loadCartCount() {
            if (!document.getElementById("cartCount")) return;
            try {
                const response = await fetch("/Cart/GetTotalItemInCart");
                if (response.ok) {
                    window.setCartCount(await response.json(), false);
                }
            } catch (err) {
                console.error(err);
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
