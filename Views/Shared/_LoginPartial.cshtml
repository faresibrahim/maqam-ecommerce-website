@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav flex-row align-items-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        var userName = User.Identity?.Name ?? "";

        <li class="nav-item">
            <a class="nav-cart" asp-controller="Cart" asp-action="GetUserCart" aria-label="Cart">
                <i class="bi bi-bag fs-5" aria-hidden="true"></i>
                <span id="cartCount" class="cart-badge is-empty" aria-hidden="true">0</span>
            </a>
        </li>

        <li class="nav-item dropdown">
            <a class="nav-link user-menu-toggle"
               href="#"
               id="userDropdown"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
                <span class="user-avatar" aria-hidden="true">@(userName.Length > 0 ? userName[0].ToString() : "?")</span>
                <span class="user-name">@userName</span>
                @if (User.IsInRole(Roles.Admin.ToString()))
                {
                    <span class="role-tag">Admin</span>
                }
                <i class="bi bi-chevron-down small text-white-50" aria-hidden="true"></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                <li>
                    <a class="dropdown-item" asp-controller="UserOrder" asp-action="UserOrders">
                        <i class="bi bi-box-seam" aria-hidden="true"></i>My orders
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="bi bi-gear" aria-hidden="true"></i>Account settings
                    </a>
                </li>
                @if (User.IsInRole(Roles.Admin.ToString()))
                {
                    <li>
                        <a class="dropdown-item" asp-controller="AdminOperations" asp-action="Index">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>Admin panel
                        </a>
                    </li>
                }
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form class="m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Landing", "Home", new { area = "" })">
                        <button type="submit" class="dropdown-item item-danger">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>Log out
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-outline-light btn-sm px-3" asp-area="Identity" asp-page="/Account/Register">
                Create account
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-emerald btn-sm px-3" asp-area="Identity" asp-page="/Account/Login">
                Log in
            </a>
        </li>
    }
</ul>
