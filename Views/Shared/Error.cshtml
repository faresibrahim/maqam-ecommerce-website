@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="page-surface">
    <div class="container">
        <div class="empty-state">
            <span class="empty-icon is-danger" aria-hidden="true"><i class="bi bi-exclamation-lg"></i></span>
            <h1>Something went wrong</h1>
            <p>We couldn't finish that request. Please try again, or head back to the shop.</p>
            @if (Model?.ShowRequestId == true)
            {
                <p class="small">Reference: <code>@Model.RequestId</code></p>
            }
            <a asp-controller="Home" asp-action="Landing" class="btn btn-emerald px-4">Back to home</a>
        </div>
    </div>
</div>
