@model IEnumerable<Order>
@{
    ViewData["Title"] = "My orders";
}

<div class="page-surface pb-5">
    <div class="container" style="max-width: 960px;">

        @if (Model != null && Model.Any())
        {
            <header class="page-head">
                <div>
                    <h1 class="page-title">My orders</h1>
                    <p class="page-lede">Track each order and see what was in it.</p>
                </div>
            </header>

            <ul class="cart-card order-list">
                @foreach (var order in Model)
                {
                    var hasDetails = order.OrderDetail != null && order.OrderDetail.Count > 0;
                    var collapseId = $"order_{order.OrderId}";
                    var itemCount = hasDetails ? order.OrderDetail!.Sum(item => item.Quantity) : 0;
                    var total = hasDetails ? order.OrderDetail!.Sum(item => item.Product.Price * item.Quantity) : 0;

                    <li class="order-row">
                        <div class="order-summary">
                            <div>
                                <div class="order-date">@order.CreatedAt.ToString("d MMMM yyyy")</div>
                                <div class="order-sub">
                                    @(itemCount == 1 ? "1 item" : $"{itemCount} items")
                                    @if (hasDetails)
                                    {
                                        <text> · @total.ToString("#,0.##") ₪</text>
                                    }
                                </div>
                            </div>

                            <span class="status-pill">@order.OrderStatus.StatusName</span>

                            @if (hasDetails)
                            {
                                <button class="btn btn-outline-light btn-sm order-toggle"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">
                                    Details <i class="bi bi-chevron-down ms-1" aria-hidden="true"></i>
                                </button>
                            }
                        </div>

                        @if (hasDetails)
                        {
                            <div class="collapse" id="@collapseId">
                                <ul class="order-detail cart-lines">
                                    @foreach (var item in order.OrderDetail!)
                                    {
                                        <li class="cart-line">
                                            <img src="/images/@(string.IsNullOrEmpty(item.Product.Image) ? "NoImage.png" : item.Product.Image)"
                                                 alt="" class="product-thumb" width="72" height="72" />
                                            <div>
                                                <h2 class="cart-line-name">@item.Product.ProductName</h2>
                                                <div class="cart-line-meta">
                                                    @item.Product.Category.CategoryName · @item.Product.Price.ToString("#,0.##") ₪ × @item.Quantity
                                                </div>
                                            </div>
                                            <div class="cart-line-end">
                                                <div class="cart-line-total">@((item.Product.Price * item.Quantity).ToString("#,0.##")) ₪</div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="empty-state">
                <span class="empty-icon" aria-hidden="true"><i class="bi bi-box-seam"></i></span>
                <h1>No orders yet</h1>
                <p>When you place an order, it will show up here with its status.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-emerald px-4">Start shopping</a>
            </div>
        }

    </div>
</div>
